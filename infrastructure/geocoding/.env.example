# Copy to .env on the VPS and replace every CHANGE_ME value.
POSTGRES_DB=nominatim
POSTGRES_USER=nominatim
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
NOMINATIM_DATABASE_DSN='pgsql:dbname=nominatim;host=postgis;port=5432;user=nominatim;password=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD'

# Start with a country/region extract. A full planet import requires roughly 1 TB
# of fast NVMe storage and a high-memory server.
OSM_PBF_URL=https://download.geofabrik.de/asia/india-latest.osm.pbf
OSM_PBF_FILE=india-latest.osm.pbf
NOMINATIM_IMPORT_STYLE=address
NOMINATIM_THREADS=8
NOMINATIM_API_WORKERS=4
NOMINATIM_API_POOL_SIZE=10

PHOTON_VERSION=1.2.1
PHOTON_HEAP=8g
# Official Photon-compatible OSM-derived database dump.
PHOTON_DB_URL=https://download1.graphhopper.com/public/photon-db-planet-1.0-latest.tar.bz2

# Bind only to loopback when the application backend runs on the same VPS.
# Change deliberately only when using a private firewall/VPN network.
GEOCODER_BIND_IP=127.0.0.1
NOMINATIM_PORT=8088
PHOTON_PORT=2322
