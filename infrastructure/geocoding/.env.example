# Docker Compose namespace. Keep stable in production because it forms volume names.
COMPOSE_PROJECT_NAME=esyglob-geocoding

# Pinned maintained Nominatim image. Upgrade only after reading release notes and
# completing a blue/green import. Never use "latest".
NOMINATIM_IMAGE=mediagis/nominatim:5.3.2-2026-04-20T06-30

# PostgreSQL/PostGIS database identity inside the Nominatim container.
# Nominatim's maintained image uses database/user "nominatim"; do not rename them.
POSTGRES_DB=nominatim
POSTGRES_USER=nominatim

# REQUIRED: generate with `openssl rand -base64 48`. Never commit the real value.
POSTGRES_PASSWORD=

# Administrative DSN used by operational tooling. Keep the host as the private
# in-container socket; the database is deliberately not exposed on TCP.
NOMINATIM_DATABASE_DSN='pgsql:dbname=nominatim;host=/var/run/postgresql;user=nominatim'

# Default India extract. For Asia or planet, replace both URL and filename.
OSM_PBF_URL=https://download.geofabrik.de/asia/india-latest.osm.pbf
OSM_PBF_FILE=india-latest.osm.pbf

# Optional checksum URL. Geofabrik publishes an MD5 file beside each PBF.
OSM_PBF_CHECKSUM_URL=https://download.geofabrik.de/asia/india-latest.osm.pbf.md5
OSM_PBF_CHECKSUM_ALGORITHM=md5

# Import concurrency for an 8-vCPU/32-GB host. Leave one CPU for the OS.
NOMINATIM_THREADS=7

# address is recommended for marketplace address search. Use full only when POI
# search is required; it increases import time and storage.
NOMINATIM_IMPORT_STYLE=address

# API workers after import. Four is appropriate for this host size.
NOMINATIM_API_WORKERS=4

# Photon release and pinned Java runtime. The Photon app JAR is verified when a
# SHA-256 value is supplied; do not switch to master snapshots.
PHOTON_VERSION=1.2.1
PHOTON_JAVA_IMAGE=eclipse-temurin:21.0.8_9-jre-jammy
PHOTON_JAR_SHA256=

# India-ready Photon 1.x database. The import script verifies the adjacent MD5.
# Asia: https://download1.graphhopper.com/public/asia/photon-db-asia-1.0-latest.tar.bz2
# Planet: https://download1.graphhopper.com/public/photon-db-planet-1.0-latest.tar.bz2
PHOTON_DB_URL=https://download1.graphhopper.com/public/asia/india/photon-db-india-1.0-latest.tar.bz2
PHOTON_DB_CHECKSUM_URL=https://download1.graphhopper.com/public/asia/india/photon-db-india-1.0-latest.tar.bz2.md5

# Java heap. 8g leaves memory for Nominatim/PostGIS on a 32-GB India host.
PHOTON_HEAP=8g

# Stable proxy image used for zero-downtime blue/green cutovers.
NGINX_IMAGE=nginx:1.28.0-alpine3.21

# Bind only to loopback. Never set 0.0.0.0 on an internet-facing VPS.
GEOCODER_BIND_IP=127.0.0.1
NOMINATIM_PORT=8088
PHOTON_PORT=2322

# Backend address-service controls. Copy these to the Node backend environment.
ADDRESS_CACHE_TTL_SECONDS=900
ADDRESS_CACHE_MAX_KEYS=5000
ADDRESS_TIMEOUT_MS=6500
# Backend currently reads this compatibility name; keep both values identical.
ADDRESS_SERVICE_TIMEOUT_MS=6500

# REQUIRED: independent 32+ byte secret for signed address selection tokens.
# Generate with `openssl rand -hex 32`; never reuse POSTGRES_PASSWORD.
ADDRESS_TOKEN_SECRET=

# Operational paths and timeouts.
BACKUP_DIR=./backups
IMPORT_TIMEOUT_SECONDS=172800
CANDIDATE_NOMINATIM_PORT=18088
CANDIDATE_PHOTON_PORT=12322
