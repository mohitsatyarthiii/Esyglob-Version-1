# Copy to .env and replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=esyglob-geocoding

# Immutable container tags. Upgrade these deliberately, never with floating latest.
NOMINATIM_IMAGE=mediagis/nominatim:5.3.2-2026-04-20T06-30
PHOTON_JAVA_IMAGE=eclipse-temurin:21.0.8_9-jre-jammy
NGINX_IMAGE=nginx:1.28.0-alpine
ALPINE_IMAGE=alpine:3.22.1

# India source data.
OSM_REGION=india
OSM_PBF_FILE=india-latest.osm.pbf
OSM_PBF_URL=https://download.geofabrik.de/asia/india-latest.osm.pbf
OSM_PBF_CHECKSUM_URL=https://download.geofabrik.de/asia/india-latest.osm.pbf.md5
NOMINATIM_REPLICATION_URL=https://download.geofabrik.de/asia/india-updates/

# Photon release and prebuilt India search index.
PHOTON_VERSION=1.2.1
PHOTON_JAR_URL=https://github.com/komoot/photon/releases/download/1.2.1/photon-1.2.1.jar
PHOTON_JAR_SHA256=6ea66d598a3f6fc1b59b0f81ad4f8abee72ccdb9d3db03bc12008974cdebd58d
PHOTON_DB_ARCHIVE=photon-db-india-1.0-latest.tar.bz2
PHOTON_DB_URL=https://download1.graphhopper.com/public/asia/india/photon-db-india-1.0-latest.tar.bz2
PHOTON_DB_CHECKSUM_URL=https://download1.graphhopper.com/public/asia/india/photon-db-india-1.0-latest.tar.bz2.md5

# Generate with: openssl rand -hex 32
NOMINATIM_PASSWORD=6aac08943e99a66d09c0329904a7a3f1336df889c8feb5cd36f6d0ba25714a02

# Only the local gateway is published. Nginx on the VPS proxies to this address.
GEOCODER_BIND_IP=127.0.0.1
NOMINATIM_PORT=8088
PHOTON_PORT=2322

# Safe defaults for the current 2 vCPU / 8 GB RAM VPS.
NOMINATIM_CPUS=1.25
PHOTON_CPUS=0.50
GATEWAY_CPUS=0.25
NOMINATIM_MEMORY_LIMIT=5g
PHOTON_MEMORY_LIMIT=1536m
GATEWAY_MEMORY_LIMIT=128m
NOMINATIM_SHM_SIZE=1gb
NOMINATIM_THREADS=1
NOMINATIM_API_POOL_SIZE=2
PHOTON_HEAP_MIN=-Xms256m
PHOTON_HEAP_MAX=-Xmx1024m

# PostgreSQL defaults sized for 8 GB RAM. The 32 GB preset is documented in README.
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_MAINTENANCE_WORK_MEM=1GB
POSTGRES_AUTOVACUUM_WORK_MEM=256MB
POSTGRES_WORK_MEM=8MB
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
POSTGRES_MAX_WAL_SIZE=2GB
POSTGRES_MAX_CONNECTIONS=50

# Safety and lifecycle controls.
MIN_FREE_DISK_GB=12
IMPORT_TIMEOUT_SECONDS=172800
STARTUP_TIMEOUT_SECONDS=900
NOMINATIM_HEALTH_START_PERIOD=48h
PHOTON_HEALTH_START_PERIOD=15m
HEALTH_RETRIES=12
HEALTH_RETRY_DELAY_SECONDS=5
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
UPDATE_STRATEGY=replication
