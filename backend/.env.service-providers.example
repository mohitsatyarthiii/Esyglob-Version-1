# Provider requests are made only by the backend. Never expose these values
# through VITE_*, React Native configuration, or client-side code.
SERVICE_PROVIDER_TIMEOUT_MS=15000
SERVICE_QUOTE_TTL_MINUTES=20

# Google address lookup, used only by the backend address-autocomplete proxy.
# Enable Places API (New) and Geocoding API, then restrict this server key.
GOOGLE_PLACES_API_KEY=

# DHL Express MyDHL API
DHL_API_BASE_URL=https://express.api.dhl.com/mydhlapi
DHL_API_USERNAME=
DHL_API_PASSWORD=
DHL_ACCOUNT_NUMBER=

# FedEx REST APIs
FEDEX_API_BASE_URL=https://apis.fedex.com
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=

# Shiprocket
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=

# Delhivery
DELHIVERY_API_BASE_URL=https://track.delhivery.com
DELHIVERY_API_TOKEN=
DELHIVERY_PICKUP_NAME=
DELHIVERY_HEALTH_PINCODE=110001
DELHIVERY_HEALTH_DESTINATION_PINCODE=400001

# DigiLocker requester OAuth. The redirect URI must exactly match the value in
# Consumer APIs > Requester configuration in the API Setu partner portal.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://esyglob.in/api/suppliers/verification/digilocker/callback
# Keep empty until the approved DOCTYPEs and their business/identity purpose
# are confirmed for this requester account. Never enable documents by guessing.
# Entry shape: {"doctype":"ABCDE","type":"business_registration","label":"...","category":"business","matchFields":["companyName","businessRegistrationNumber"]}
DIGILOCKER_AUTHORIZED_DOCUMENTS=[]



