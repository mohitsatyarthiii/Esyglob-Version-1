# Browser API requests stay same-origin and are proxied by the hosting layer.
VITE_API_BASE_URL=/api

# Keep realtime same-origin so it shares the secure, HttpOnly session cookie.
VITE_REALTIME_URL=/

# Netlify supports Socket.IO polling through the rewrite but not WebSocket upgrade.
# Set true only when /socket.io/ is served by an upgrade-capable reverse proxy.
VITE_REALTIME_WEBSOCKET=false

# Used only by the local Vite development proxy.
VITE_API_PROXY_TARGET=https://api.esyglob.in
