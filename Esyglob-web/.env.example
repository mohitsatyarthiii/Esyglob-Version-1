# Production uses the API origin directly so HTTP and WebSocket authentication
# share the same secure, HttpOnly session cookie.
VITE_API_BASE_URL=https://api.esyglob.in/api

# Netlify rewrites support polling but not WebSocket upgrade; use the Nginx API origin.
VITE_REALTIME_URL=https://api.esyglob.in

# Used only by the local Vite development proxy.
VITE_API_PROXY_TARGET=https://api.esyglob.in
